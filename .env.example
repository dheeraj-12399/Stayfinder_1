# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# CLOUDFLARE TURNSTILE CONFIGURATION
# TURNSTILE_SITEKEY: Public site key used by the client/frontend widget.
# For testing, you can use Cloudflare's test site key: 1x00000000000000000000AA (always passes)
TURNSTILE_SITEKEY=1x00000000000000000000AA

# TURNSTILE_SECRET_KEY: Private secret key used ONLY by the backend server to validate tokens.
# NEVER expose this key in client-side code, Android APKs, or public repositories.
# For testing, you can use Cloudflare's test secret key: 1x0000000000000000000000000000000AA (always passes)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Optional: Custom backend verification URL (defaults to http://10.0.2.2:3000/api/verify-turnstile or local proxy)
TURNSTILE_BACKEND_URL=http://10.0.2.2:3000/api/verify-turnstile

