# Vercel Environment Variables
# Add this variable in your Vercel Project Settings > Environment Variables:

# Cloudflare Turnstile Secret Key (Backend Only)
# For testing: 1x0000000000000000000000000000000AA
# For production: Obtain from your Cloudflare Dashboard -> Turnstile -> Your Widget -> Secret Key
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
